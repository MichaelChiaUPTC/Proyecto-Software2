# Copiar a .env (no subir .env a git)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Detrás de un proxy inverso (Caddy en producción) poner 1; sin proxy, 0.
# TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=uptc
DB_PASSWORD=uptc_dev
DB_NAME=uptc

# Mínimo 16 caracteres. En producción: valor aleatorio largo.
JWT_SECRET=cambia-este-secreto-en-produccion
# Solo para las pruebas (usuario root del MySQL de docker compose)
MYSQL_ROOT_PASSWORD=root

# Motor de corrección (opcionales; estos son los valores por omisión)
# RUNNER_IMAGE=python:3.12-alpine
# RUNNER_TIMEOUT_MS=3000
# RUNNER_MEMORY=128m
# RUNNER_CPUS=0.5
# RUNNER_PIDS=64
# RUNNER_MAX_CONCURRENT=4
# SUBMIT_RATE_LIMIT_MAX=10
# OUTBOX_INTERVAL_MS=30000

# Pistas con IA (Fase 3b). AI_PROVIDER=gemini|claude|none (por omision none: se usan las pistas fijas)
# AI_PROVIDER=none
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=8000
