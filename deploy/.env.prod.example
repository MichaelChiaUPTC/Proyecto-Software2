# Copiar a deploy/.env (lo hace instalar-vm.sh). NUNCA subir .env a git.
# Los valores marcados GENERAR los rellena instalar-vm.sh con openssl; los marcados EDITAR los pones tu.

# --- Dominio y HTTPS (EDITAR) ---
# Dominio de la VM sin http:// (p. ej. uptc-python.duckdns.org). Caddy pide el certificado a Let's Encrypt solo.
DOMAIN=
# Correo para avisos de Let's Encrypt (vencimiento del certificado)
ACME_EMAIL=
# Puertos del host; en la VM dejar 80 y 443
HTTP_PORT=80
HTTPS_PORT=443

# --- CORS (EDITAR) ---
# URL exacta del frontend en Vercel, sin barra final. Varias separadas por coma.
# Ej.: https://uptc-python.vercel.app
CORS_ORIGIN=

# --- Secretos (GENERAR) ---
# JWT_SECRET: al menos 16 caracteres; instalar-vm.sh usa 48 hex.
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_NAME=uptc
DB_USER=uptc

# --- Limites (opcionales) ---
# Intentos de login fallidos por IP y 15 min / envios por usuario y minuto
LOGIN_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_MAX=10
# Correcciones simultaneas (cada una es un contenedor de 128 MB)
RUNNER_MAX_CONCURRENT=4
RUNNER_IMAGE=python:3.12-alpine

# --- IA para las pistas (opcional) ---
# none = pistas fijas del curso | gemini | claude
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- DuckDNS (EDITAR; lo usa duckdns.sh) ---
# Solo el subdominio (sin .duckdns.org) y el token de https://www.duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- n8n y SMTP (opcional; perfil `automatizacion`) ---
# n8n solo escucha en 127.0.0.1:N8N_PORT de la VM (acceso por tunel SSH).
# El SMTP (Gmail con contrasena de aplicacion, Brevo...) se configura dentro de n8n como credencial "SMTP UPTC"
# (ver n8n/README.md); su clave NO va en este archivo. Anota aparte: host smtp.gmail.com, puerto 587, usuario.
N8N_PORT=5678

# --- Backups (usados por backup-mysql.sh) ---
# Carpeta de respaldos (relativa a deploy/ o absoluta) y dias de retencion
BACKUP_DIR=./backups
BACKUP_DIAS=7
