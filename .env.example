# Copiar a .env (no subir .env a git). Lo lee docker compose.
MYSQL_ROOT_PASSWORD=root
DB_NAME=uptc
DB_USER=uptc
DB_PASSWORD=uptc_dev
# Mínimo 16 caracteres. En producción: valor aleatorio largo.
JWT_SECRET=cambia-este-secreto-en-produccion
CORS_ORIGIN=http://localhost:5173
# Puertos del host (cambiar si 3306/3000 están ocupados)
MYSQL_PORT=3306
API_PORT=3000
# GID del grupo dueño de /var/run/docker.sock (0 en Docker Desktop; en Linux: stat -c %g /var/run/docker.sock)
DOCKER_GID=0
